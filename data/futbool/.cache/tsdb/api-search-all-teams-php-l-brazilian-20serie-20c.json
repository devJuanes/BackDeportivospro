no","idLeague4":"5773","strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"17611","strStadium":"Estádio Estadual Lourival Baptista","strKeywords":"Dragão do Bairro Industrial","strRSS":"","strLocation":"Aracaju, Sergipe","strWebsite":"www.adconfianca.com.br","strFacebook":"www.facebook.com/adconfianca","strTwitter":"www.twitter.com/adc_confianca","strInstagram":"www.instagram.com/confiancaoficial","strDescriptionEN":"Associação Desportiva Confiança, or Confiança as they are usually called, is a sergipano club from Aracaju in Sergipe, founded on May 1, 1936.\r\n\r\nConfiança's greatest rival is Sergipe.\r\n\r\nHome stadium is the Proletário Sabino Ribeiro stadium, capacity 4,000.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Brazil","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/v9y3ye1579337829.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"www.youtube.com/channel/UCN2KzyGQ7Zrg2cHb_kTCoqg","strLocked":"unlocked"},{"idTeam":"142270","idESPN":"0","idAPIfootball":"7826","intLoved":null,"strTeam":"Ferroviária","strTeamAlternate":"Associação Ferroviária de Esportes","strTeamShort":"","intFormedYear":"1950","strSport":"Soccer","strLeague":"Brazilian Serie C","idLeague":"4625","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"33118","strStadium":"Arena da Fonte Luminosa","strKeywords":"","strRSS":"","strLocation":"Araraquara, São Paulo, Brazil","strWebsite":"","strFacebook":"","strTwitter":"","strInstagram":"","strDescriptionEN":"Associação Ferroviária de Esportes, commonly referred to as simply Ferroviária, is a Brazilian association football club in Araraquara, São Paulo. They currently play in the Série D, the fourth tier of Brazilian football, as well as in the Campeonato Paulista Série A1, the top tier of the São Paulo state football league. Founded on April 12, 1950, Ferroviária is the only Araraquara club to reach the Campeonato Paulista first division. The club's best campaign in that competition was in 1959, when the club finished in the third position. It is also the only club of the city to have competed in the Campeonato Brasileiro Série B. The club competed in this competition in 1995.\r\n\r\nThey play in carmine shirts, white shorts and socks.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Brazil","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/zfo1y81766506623.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"134462","idESPN":"0","idAPIfootball":"137","intLoved":"1","strTeam":"Figueirense","strTeamAlternate":"Figueira","strTeamShort":"","intFormedYear":"1921","strSport":"Soccer","strLeague":"Brazilian Serie C","idLeague":"4625","strLeague2":"Brazilian Campeonato Catarinense","idLeague2":"5687","strLeague3":"Copa do Brasil","idLeague3":"4725","strLeague4":"","idLeague4":null,"strLeague5":"