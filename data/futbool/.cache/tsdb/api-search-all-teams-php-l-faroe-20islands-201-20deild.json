itter":"","strInstagram":"","strDescriptionEN":"Nes Sóknar Ítróttarfelag Runavík II, or simply NSÍ II, is a Faroese football club based in Runavík. It is the reserve team of the Faroe Islands Premier League club NSÍ Runavík.\r\n\r\nReserve teams in the Faroe Islands play in the same league system as their senior team, rather than in a reserve league, but they cannot play in the same division as their senior team, so NSÍ II is ineligible for promotion to the Faroe Islands Premier League and also cannot play in the Faroe Islands Cup.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Faroe Islands","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/mdtxjo1615841379.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"141146","idESPN":"0","idAPIfootball":"4182","intLoved":null,"strTeam":"Suðuroy","strTeamAlternate":"FC Suduroy, VB/Sumba","strTeamShort":"","intFormedYear":"2010","strSport":"Soccer","strLeague":"Faroe Islands 1. deild","idLeague":"4961","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"20878","strStadium":"á Eiðinum","strKeywords":"","strRSS":"","strLocation":"Vágur","strWebsite":"fcsuduroy.com","strFacebook":"www.facebook.com/groups/232008840181064/","strTwitter":"","strInstagram":"","strDescriptionEN":"FC Suðuroy is a Faroese football club which was founded in January 2010 and consists currently of the former clubs VB (founded in 1905) and Sumba (founded in 1949), which merged in 2005 to form VB/Sumba. FC Suðuroy's first team in the men's championship competes in the 1. deild in 2021. All teams play their home games at the á Eiðinum Stadium in Vágur. The club logo was designed by the photographer Rógvi Nolsøe Johansen in 2010, the same year he won the competition to design a logo for the club.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Faroe Islands","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/owtkmo1615841384.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"www.youtube.com/channel/UCEbgkUZNwTDviwDZUOCQoWA","strLocked":"unlocked"},{"idTeam":"138055","idESPN":"0","idAPIfootball":"4192","intLoved":null,"strTeam":"TB Tvøroyri","strTeamAlternate":"Tvøroyrar Bóltfelag","strTeamShort":"","intFormedYear":"1892","strSport":"Soccer","strLeague":"Faroe Islands 1. deild","idLeague":"4961","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"17152","strStadium":"Við Stórá","strKeywords":"","strRSS":"","strLocation":"Trongisvágur","strWebsite":"www.tb.fo","strFacebook":"","strTwitter":"","strInstagram":"","strDescriptionEN":"Tvøroyrar Bóltfelag is a Faroese football club from Tvøroyri, currently playing in the Effodeildin, the top tier of Faroese football. TB Tvøroyri is the oldest football club in the Faroe Islands, and also one of the oldest in the Danish Realm, in which the Faroe Islands are a self-governing country.\r\n\r\nAfter the end of the 2016 season it was decided on 15 December 2016 that the three clubs of the island Suðuroy, which are TB Tvøroyri, FC Suðuroy and Royn Hvalba would merge into a new club for the 2017 season. The merger will not be complete until 2018 and the name will be all three names together for the 2017 season: TB/FC Suðuroy/Royn. The three clubs have not been dissolved yet, they continue separately for the children's and women's teams. In 2017 it will only be the men's teams which will play for the new cooperation. In Faroese the new team is referred to as Suðuroyarliðið (the Suðuroy-team). The first head coach for the Suðuroy-team is the Scottish manager Maurice Ross.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Faroe Islands","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/2kzda01579294745.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"141147","idESPN":"0","idAPIfootball":"4183","intLoved":null,"strTeam":"Víkingur Gøta II","strTeamAlternate":"Víkingur II","strTeamShort":"","intFormedYear":"2008","strSport":"Soccer","strLeague":"Faroe Islands 1. deild","idLeague":"4961","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"17153","strStadium":"Sarpuger