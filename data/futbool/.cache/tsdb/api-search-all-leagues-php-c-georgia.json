rDescriptionDE":null,"strDescriptionFR":null,"strDescriptionIT":null,"strDescriptionCN":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionPL":null,"strDescriptionIL":null,"strTvRights":"","strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strBadge":"https://r2.thesportsdb.com/images/media/league/badge/ofw1r21772205826.png","strLogo":"https://r2.thesportsdb.com/images/media/league/logo/i0p8sb1772205825.png","strPoster":null,"strTrophy":null,"strNaming":"{strHomeTeam} vs {strAwayTeam}","strComplete":"No","strLocked":"unlocked"},{"idLeague":"5915","idAPIfootball":"8405","idAPIfootballv3":"530","strSport":"Soccer","strLeague":"Georgian Super Cup","strLeagueAlternate":"საქართველოს საფეხბურთო სუპერთასი","intDivision":"99","idCup":"1","strCurrentSeason":"2026","intFormedYear":"1996","dateFirstEvent":null,"strGender":"Male","strCountry":"Georgia","strWebsite":"gff.ge/ge/supercup-1","strFacebook":"","strInstagram":"","strTwitter":"","strYoutube":"","strRSS":"","strDescriptionEN":"The Georgian Super Cup is a super cup tournament in Georgian football. Founded in 1996 as a two-team competition, the current version has been contested since 2023 by four teams, those being the first, second, and third placed teams in the Erovnuli Liga, as well as the winners of the Georgian Cup.\r\n\r\nFormerly, the tournament used to be a single football match solely played between the champions of the Erovnuli Liga and the winners of the Georgian Cup. When a club had won both competitions, the Georgian Cup losing finalists play for the Super Cup. This occurred in 1996, 1997, 2013 and 2014 when Dinamo Tbilisi won the double on all four occasions.\r\n\r\nIn 2023, the format of Super Cup changed to be contested between four teams. The three teams that qualified for the Champions League and Europa Conference League from the Erovnuli Liga and the winners of the Georgian Cup play one-legged semi-finals, and a final. The losers of each semi-final play a third place play-off.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionIT":null,"strDescriptionCN":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionPL":null,"strDescriptionIL":null,"strTvRights":"","strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strBadge":"https://r2.thesportsdb.com/images/media/league/badge/mtg3s21783009422.png","strLogo":null,"strPoster":null,"strTrophy":null,"strNaming":"{strHomeTeam} vs {strAwayTeam}","strComplete":"No","strLocked":"unlocked"}]}