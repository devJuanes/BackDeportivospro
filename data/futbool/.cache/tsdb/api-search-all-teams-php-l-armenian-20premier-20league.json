tionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Armenia","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/4fd6ht1719597125.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"www.youtube.com/channel/UCfH_naU5tNIpLAjOb22kVlA","strLocked":"unlocked"},{"idTeam":"137895","idESPN":"0","idAPIfootball":"3684","intLoved":null,"strTeam":"Noah","strTeamAlternate":"","strTeamShort":"","intFormedYear":"2017","strSport":"Soccer","strLeague":"Armenian Premier League","idLeague":"4619","strLeague2":"Armenian Cup","idLeague2":"4909","strLeague3":"UEFA Conference League","idLeague3":"5071","strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"31495","strStadium":"Abovyan City Stadium","strKeywords":"","strRSS":"","strLocation":"Yerevan, Armenia","strWebsite":"","strFacebook":"www.facebook.com/noah.footballclub/","strTwitter":"","strInstagram":"www.instagram.com/noah.footballclub/?hl=en","strDescriptionEN":"Football Club Noah is an Armenian football club based in Yerevan. It was founded in June 2019 by Karen Abrahamyan.\r\nThe club's inaugural match took place on June 2, 2017, against FC Banants at Banants Stadium. The friendly match ended with a goalless draw.Tigran Yesayan was the first manager to coach the newly founded team and remained in his position until 29 January 2018.\r\nNoah played their first competitive season -as Artsakh- in the 2018–19 Armenian Premier League. and was promoted to the Armenian Premier League by obtaining second place.\r\nBy the beginning of 2019, it was announced that Karen Abrahamyan became the new owner of Artsakh. In summer 2019, the club was re-branded and renamed FC Noah.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Armenia","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/qylmss1720503567.png","strLogo":"https://r2.thesportsdb.com/images/media/team/logo/ugkc9x1596470423.png","strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"137896","idESPN":"0","idAPIfootball":"709","intLoved":null,"strTeam":"Pyunik Yerevan","strTeamAlternate":"","strTeamShort":"","intFormedYear":"1992","strSport":"Soccer","strLeague":"Armenian Premier League","idLeague":"4619","strLeague2":"Armenian Cup","idLeague2":"4909","strLeague3":"UEFA Conference League","idLeague3":"5071","strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"22682","strStadium":"Junior Sport Stadium","strKeywords":"","strRSS":"","strLocation":"Shengavit, Yerevan, Armenia","strWebsite":"fcpyunik.am/hy","strFacebook":"www.facebook.com/fcpyunik","strTwitter":"twitter.com/fc_pyunik","strInstagram":"www.instagram.com/pyunik_fc","strDescriptionEN":"Football Club Pyunik commonly known as Pyunik, is an Armenian professional football club based in Yerevan. Pyunik is one of the most popular football clubs in Armenia.\r\nThe club headquarters are located on Masis street 7, Yerevan. The Pyunik Training Centre is located in the Kentron District of Yerevan. \r\nFounded in 1992 as Homenetmen Yerevan, the club won the first Armenian Premier League competition held in 1992 (shared with Shirak). In 1995, Homenetmen Yerevan was renamed FC Pyunik (Armenian for \"Phoenix\").","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Armenia","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/h8jwvd1579003944.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"www.youtube.com/user/pyunikyerevan","strLocked":"unlocked"},{"idTeam":"152593","idESPN":"0","idAPIfootball":"26198","intLoved":null,"strTeam":"Sardarapat","strTeamAlternate":"Sardarapat Football Club, Սարդարապատ ֆուտբոլային ակումբ","strTeamShort":"","intFormedYear":"2021","strSport":"Soccer","strLeague":"Armenian Premier League","idLeague":"4619","strLeague2":"Armenian Cup","idLeague2":"4909","strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"22681","strStadium":"Armavir City Stadium","strKeywords":"","strRSS":"","strLocation":"Armavir, Armenia","strWebsite":"","strFacebook":"","strTwitter":"","strInstagram":"","strDescriptionEN":null,"strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"str