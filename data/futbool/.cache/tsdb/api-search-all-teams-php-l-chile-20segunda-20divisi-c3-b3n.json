o","strDescriptionEN":null,"strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Chile","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/ay1au91719394353.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"148531","idESPN":"0","idAPIfootball":"5639","intLoved":null,"strTeam":"General Velásquez","strTeamAlternate":"Club Deportivo General Velásquez","strTeamShort":"","intFormedYear":"1908","strSport":"Soccer","strLeague":"Chile Segunda División","idLeague":"5481","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"32242","strStadium":"Estadio Municipal Augusto Rodríguez","strKeywords":"General, Verdes, El Militar","strRSS":"","strLocation":"San Vicente de Tagua Tagua, Chile","strWebsite":"","strFacebook":"www.facebook.com/gralvelasquez","strTwitter":"www.twitter.com/gralvelasquez","strInstagram":"","strDescriptionEN":"General Velásquez is a Chilean football club, their home town is San Vicente de Tagua Tagua, Chile. They currently play in the third level of Chilean football, the Segunda Division.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Chile","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/6v8uth1719394356.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"155066","idESPN":"0","idAPIfootball":"27606","intLoved":null,"strTeam":"Lota Schwager","strTeamAlternate":"Club de Deportes Lota Schwager","strTeamShort":"","intFormedYear":"1966","strSport":"Soccer","strLeague":"Chile Segunda División","idLeague":"5481","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"33430","strStadium":"Estadio Municipal Federico Schwager","strKeywords":"Lamparita / Mineros / Carboneros","strRSS":"","strLocation":"Coronel, Chile","strWebsite":"","strFacebook":"","strTwitter":"","strInstagram":"","strDescriptionEN":"Lota Schwager Sports Club is a Chilean professional team based in Coronel that currently play in Tercera A (fourth-tier).\r\n\r\nThe Lota Schwafer Sports Club was founded on 10 May 1966 as a merge between the Federico Schwager Club (named after local businessman Federico Schwager) and the Minas Lota Club (teams that competed in Campeonato Regional de Concepción representing Lota and Schwager companies), under the name of \"Lota Schwager\", making reference to both companies latest mentioned. Having their debut–season the same year (where they finished ninth, after a poor campaign), \"The Little Lamp\" under the coach Isaac Carrasco achieved its first promotion to top-division in 1969, where Coronel-based team remained until 1980.\r\n\r\nAfter they won their second Primera B title in 1986, Lota returned to first-tier thanks to manager Juan Carlos Gangas' job, but they only stayed at Primera División one season, after of defeat the Promotion Play-offs against O'Higgins and Regional Atacama. Following Coronel mining-crisis of 1994, the club disappeared during seven years, starting out again in 2001 for play as an amateur team in Tercera División, winning that in they first attempt to reach it.\r\n\r\nIn 2006, after a good campaign in second-tier (where even so were four managers who coached Lota: Leonardo Vinés, Humberto López, Márcio da Silva and Jaime Nova), finishing third in the table behind the champion Deportes Melipilla and runner-up Ñublense, the team played the Promotion Play-offs against Talca-based club Rangers, which won at their home stadium Federico Schwager on the penalties thanks to Cristián Limenza's performances in the goal saving penalties.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"#E30B13","strColour2":"#000000","strColour3":"#28A737","strGender":"Male","strCountry":"Chile","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/igau631773031601.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"148533","idESPN":"0","idAPIfootball":"5643","intLoved":null,"strTeam":"Provincial Osorno","strTeamAlternate":"Club Deportivo Deportes Provincial Osorno","strTeamShort":"","intFormedYear":"2012","strSport":"Soccer","strLeague":"Chile Segunda División","idLeague":"5481","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"32243","strStadium":"Estadio Municipal Rubén Marcos Peralta","strKeywords":"Toros, Provi, Lecheros","strRSS":"","strLocation":"Osorno, Chile","strWebsite":"","strFacebook":"www.facebook.com/CDDPOsorno","strTwitter":"","strInstagram":"www.instagram.com/cddposorno","strDescriptionEN":"Provincial Osorno is a football club based in Osorno, Los Lagos Region, Chile. The club is currently playing at the third tier of the Chilean football system, the Segunda División.\r\n\r\nThe club were founded on 5 June 1983 and then re-founded on 3 December 2012.\r\n\r\nBetween 1993 and 1998, a period of 6 years, they were continuously members of Chile's top division although they never finished higher than sixth.\r\n\r\nUntil 2009 the club also operated a basketball professional team, Provincial Osorno Basquetbol, They played in the Chilean Basketball Professional League.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Chile","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/jo4rlk1719530237.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"148534","idESPN":"0","idAPIfootball":"18776","intLoved":null,"strTeam":"Provincial Ovalle","strTeamAlternate":"Club Deportivo Provincial Ovalle Fútbol Club","strTeamShort":"","intFormedYear":"1942","strSport":"Soccer","strLeague":"Chile Segunda División","idLeague":"5481","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":