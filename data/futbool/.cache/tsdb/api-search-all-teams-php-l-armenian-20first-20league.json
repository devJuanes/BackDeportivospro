{"teams":[{"idTeam":"147557","idESPN":"0","idAPIfootball":"21877","intLoved":null,"strTeam":"Andranik","strTeamAlternate":"Andranik Football Club, Անդրանիկ ՖԱ","strTeamShort":"","intFormedYear":"2023","strSport":"Soccer","strLeague":"Armenian First League","idLeague":"4908","strLeague2":"Armenian Cup","idLeague2":"4909","strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"29881","strStadium":"Sevan City Stadium","strKeywords":"","strRSS":"","strLocation":"Sevan, Armenia","strWebsite":"","strFacebook":"","strTwitter":"","strInstagram":"","strDescriptionEN":"Andranik Football Club (Armenian: Անդրանիկ ՖԱ, romanized: Andranik Futbolayin Akumb) commonly known as Andranik FC, is an Armenian football club based in Sevan. They currently play in the Armenian First League. The home stadium of the team is the Sevan Stadium. The club headquarters are located in Vardenis 1601, st. Lernagortsneri 6.\r\n\r\nThe club was founded in Sevan. They took part in their first professional championship in Armenian First League in 2023/24 season and finished 6th. The club also participated in Armenian Cup, losing in First Round 6–0 to BKMA.\r\n\r\nIn 2024–25 edition of tournament Andranik FC lost again in the first round, in a match against Van. They finished 7th in the league the same season.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":null,"strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Armenia","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/6wd8p31742400922.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFa