nNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Mexico","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/s187km1783492630.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":null,"strYoutube":"","strLocked":"unlocked"},{"idTeam":"135739","idESPN":"3432","idAPIfootball":"2297","intLoved":null,"strTeam":"Dorados de Sinaloa","strTeamAlternate":"Dorados","strTeamShort":"","intFormedYear":"2003","strSport":"Soccer","strLeague":"Mexican Liga de Expansión MX","idLeague":"4654","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"17553","strStadium":"Estadio de Mazatlán","strKeywords":"","strRSS":"","strLocation":"Culiacán, Sinaloa, Mexico","strWebsite":"www.doradosfc.com.mx","strFacebook":"www.facebook.com/doradosfc","strTwitter":"www.twitter.com/Dorados","strInstagram":"www.instagram.com/DoradosOficial","strDescriptionEN":"Dorados de Sinaloa, or Dorados, is a Mexican professional football club based in Culiacán. The club plays its home games in Culiacán, Mexico. Dorados was the youngest franchise to play in the Primera División de México, having joined the division for the first time for the Apertura 2004 tournament, when the club was only one year old. Dorados currently plays in Ascenso MX, the second tier of the Mexican league. The goalkeeper's primary colours are a red shirt and white shorts, and the secondary attire is all white.","strDescriptionDE":null,"strDescriptionFR":null,"strDescriptionCN":null,"strDescriptionIT":"Il Club Social y Deportivo Dorados de Sinaloa, noto semplicemente come Dorados, è una società calcistica messicana di Culiacán, fondata nel 2003. Milita nella Liga de Expansión MX, la seconda serie del campionato messicano di calcio. Deve il suo nome al pesce marino chiamato dorado, che figura anche nel suo stemma sociale.\r\n\r\nLa squadra disputò la prima stagione in Primera División nel 2004, appena un anno dopo la fondazione del club.","strDescriptionJP":null,"strDescriptionRU":null,"strDescriptionES":null,"strDescriptionPT":null,"strDescriptionSE":null,"strDescriptionNL":null,"strDescriptionHU":null,"strDescriptionNO":null,"strDescriptionIL":null,"strDescriptionPL":null,"strColour1":"","strColour2":"","strColour3":"","strGender":"Male","strCountry":"Mexico","strBadge":"https://r2.thesportsdb.com/images/media/team/badge/ofmki71580499474.png","strLogo":null,"strFanart1":null,"strFanart2":null,"strFanart3":null,"strFanart4":null,"strBanner":null,"strEquipment":"https://r2.thesportsdb.com/images/media/team/equipment/dnqw7x1629145982.png","strYoutube":"www.youtube.com/DoradosTV","strLocked":"unlocked"},{"idTeam":"138897","idESPN":"10131","idAPIfootball":"19905","intLoved":null,"strTeam":"Jaiba Brava","strTeamAlternate":"Club Jaiba Brava, Tampico Madero","strTeamShort":"","intFormedYear":"1945","strSport":"Soccer","strLeague":"Mexican Liga de Expansión MX","idLeague":"4654","strLeague2":"","idLeague2":null,"strLeague3":"","idLeague3":null,"strLeague4":"","idLeague4":null,"strLeague5":"","idLeague5":null,"strLeague6":"","idLeague6":null,"strLeague7":"","idLeague7":null,"strDivision":null,"idVenue":"19664","strStadium":"Estadio Tamaulipas","strKeywords":"","strRSS":"","strLocation":"Tampico & Ciudad Madero, Tamaulipas, Mexico","strWebsite":"","strFacebook":"","strTwitter":"","strInstagram":"","strDescriptionEN":"Club Jaiba Brava, formerly known as Tampico Madero, is a Mexican professional football club based in Tampico and Ciudad Madero, Tamaulipas, that plays in Liga de Expansión MX, the second level division of Mexican football. The club was founded in 1982 as Deportivo Social Tampico Madero. The club changed its name to TM Fútbol Club in 2016, then again to Club Depo